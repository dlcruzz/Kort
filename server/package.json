{
  "name": "kort-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API do Kort: agendamento público, rotinas automáticas, WhatsApp, mensalidade e painel admin.",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --env-file=.env.test --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "luxon": "^3.6.1",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3"
  }
}
