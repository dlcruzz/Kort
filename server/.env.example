# Copie para .env e preencha.

# Servidor
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
FUSO=America/Sao_Paulo

# Banco: Supabase > Project Settings > Database > Connection string (URI, modo "Session")
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Login: o back-end confere o token do Supabase Auth enviado pelo front.
SUPABASE_URL=https://xxxx.supabase.co
# Projetos antigos usam a "JWT Secret" (Settings > API). Se o seu projeto usa as
# chaves novas (assinatura assimétrica), deixe vazio: a API busca as chaves em SUPABASE_URL.
SUPABASE_JWT_SECRET=

# Endereços do front (separados por vírgula) liberados no CORS
CORS_ORIGENS=http://localhost:5173
# Base do link que vai nas mensagens (página pública e "meu horário")
LINK_PUBLICO_BASE=http://localhost:5173

# Segredo para assinar o link "meu horário" que o cliente recebe. Gere um texto aleatório longo.
TOKEN_SECRET=troque-por-um-texto-aleatorio-bem-longo

# Mensalidade do Kort (Pix na sua conta Nu Empresas)
PIX_CHAVE=sua-chave-pix
PIX_NOME=KORT
PIX_CIDADE=SAO PAULO

# WhatsApp: "console" só escreve no terminal (para testar). "zapi" envia de verdade.
WHATSAPP_PROVEDOR=console
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Token que o gateway de pagamento manda no cabeçalho x-webhook-token (se usar um)
WEBHOOK_TOKEN=

# Liga as rotinas automáticas (lembretes, faturas, resumo). Em mais de um servidor, ligue em um só.
ROTINAS_ATIVAS=true
