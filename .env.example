# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Chave Pix da conta Nu Empresas usada para gerar as faturas da mensalidade
VITE_KORT_PIX_CHAVE=sua-chave-pix

# Endereço da API (pasta server/)
VITE_API_URL=http://localhost:3333
