# Tudo aqui é opcional: o app já vem ligado no projeto Supabase de produção
# e na chave Pix do Kort (veja src/lib/supabase.ts e Configuracoes.tsx).
# Use estas variáveis só para trocar de projeto. VITE_KORT_DEMO=1 desliga o
# banco e abre a demonstração com dados de exemplo (para mexer nas telas).
# VITE_KORT_DEMO=1

# Supabase > Project Settings > API (use a chave "anon public", NUNCA a service_role)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Pix da sua conta Nu Empresas, para o QR code da mensalidade
VITE_KORT_PIX_CHAVE=sua-chave-pix
VITE_KORT_PIX_NOME=SEU NOME OU EMPRESA
VITE_KORT_PIX_CIDADE=SAO PAULO

# Só quando ligar o servidor Node (pasta server/, precisa de VPS)
VITE_API_URL=http://localhost:3333
